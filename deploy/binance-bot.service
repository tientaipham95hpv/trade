[Unit]
Description=Trader Stack OFFLINE Supervisor
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/trader-stack
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trader-stack/venv/bin/python -B scripts/trader_stack_supervisor.py --env-file /opt/trader-stack/.runtime/trader-stack.env
ExecStop=/usr/bin/touch /opt/trader-stack/.runtime/stop.request
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
