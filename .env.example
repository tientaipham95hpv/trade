# ==========================================
# BINANCE FUTURES API CONFIGURATION
# ==========================================
# Nhập API Key và Secret từ tài khoản Binance của bạn
# CHÚ Ý: Chỉ cấp quyền "Enable Futures", KHÔNG cấp quyền "Enable Withdrawals"
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Chế độ chạy:
# USE_TESTNET: True = Chạy trên Binance Futures Testnet (https://testnet.binancefuture.com)
#              False = Chạy trên Binance Real (Live)
USE_TESTNET=True

# Chế độ DRY_RUN (Paper Trading / Giả lập):
# True = Bot sẽ phân tích và tạo lệnh giả lập ghi log, KHÔNG gửi lệnh lên sàn (Cực kỳ an toàn)
# False = Gửi lệnh thực sự lên Binance (theo Testnet hoặc Live tùy cài đặt ở trên)
DRY_RUN=True

# ==========================================
# CHẾ ĐỘ QUẢN LÝ VỐN & ĐI TIỀN (CAPITAL & RISK)
# ==========================================
# SIZING_MODE:
# 'risk_percent'   : Rủi ro cố định % vốn mỗi lệnh theo khoảng cách Stop Loss (KHUYÊN DÙNG)
# 'margin_percent' : Ký quỹ cố định X% vốn khả dụng hiện có
# 'fixed_amount'   : Ký quỹ cố định số tiền USDT mỗi lệnh
SIZING_MODE=risk_percent

# Nếu dùng 'risk_percent': Tỷ lệ % tài khoản chấp nhận mất tối đa khi dính Stop Loss (1.0 = 1%)
RISK_PER_TRADE_PERCENT=1.0

# Nếu dùng 'margin_percent': Tỷ lệ % vốn dùng làm ký quỹ (ví dụ 5.0 = 5% balance)
MARGIN_PERCENT_PER_TRADE=5.0

# Nếu dùng 'fixed_amount': Số USDT ký quỹ cố định mỗi lệnh
FIXED_USDT_PER_TRADE=50.0

# Mức đòn bẩy mặc định (Khuyến nghị từ 3 đến 5)
LEVERAGE=5

# Chế độ ký quỹ: ISOLATED (Bảo toàn vốn, không cháy chéo)
MARGIN_TYPE=ISOLATED

# Tỷ lệ Risk : Reward mục tiêu (1.5 nghĩa là R:R = 1:1.5, chấp nhận lỗ 1R để ăn 1.5R)
RISK_REWARD_RATIO=1.5

# Kích hoạt Trailing Stop / Dời SL về hòa vốn khi lãi đạt 1R
USE_BREAKEVEN_STOP=True

# Giới hạn lỗ tối đa trong ngày (% tài khoản). Nếu chạm ngưỡng này, bot tự ngắt 24h
MAX_DAILY_LOSS_PERCENT=5.0

# Số vị thế mở tối đa cùng một thời điểm (để tránh rủi ro sập dây chuyền)
MAX_CONCURRENT_POSITIONS=3

# ==========================================
# MARKET SCANNER CONFIGURATION (QUÉT THỊ TRƯỜNG)
# ==========================================
# ENABLE_SCANNER: True = Tự động quét các cặp coin đạt tiêu chuẩn
#                 False = Chỉ chạy danh sách cố định trong TARGET_SYMBOLS
ENABLE_SCANNER=True

# Khối lượng giao dịch 24h tối thiểu (USDT) để bot quét (tránh coin rác, trượt giá)
MIN_24H_VOLUME_USDT=50000000

# Ngưỡng Funding Rate an toàn tối đa (tránh coin đang bị fee funding bào mòn)
MAX_FUNDING_RATE=0.0005

# Danh sách cặp coin dự phòng nếu không bật scanner (phân cách bằng dấu phẩy)
TARGET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ==========================================
# TELEGRAM NOTIFIER (TÙY CHỌN BÁO ĐỘNG VỀ ĐIỆN THOẠI)
# ==========================================
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
